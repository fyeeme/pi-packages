{
	"name": "@fyeeme/pi-goal",
	"version": "1.0.7",
	"description": "Goal mode for pi — session-log-backed long-running objective: get_goal/create_goal/update_goal tools, /goal command, token budget accounting (default 2M) with budget-limit handling, automatic continuation turns, and strict completion/blocked audits. Rewritten from mitsuhiko/agent-stuff goal.ts.",
	"type": "module",
	"license": "MIT",
	"author": "fyeeme",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fyeeme/pi-packages.git"
	},
	"bugs": {
		"url": "https://github.com/fyeeme/pi-packages/issues"
	},
	"homepage": "https://github.com/fyeeme/pi-packages#readme",
	"engines": {
		"node": ">=18"
	},
	"keywords": [
		"pi-package",
		"pi",
		"extension",
		"goal",
		"goal-mode",
		"long-running",
		"agent-loop",
		"budget"
	],
	"files": [
		"index.ts",
		"test",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"scripts": {
		"test": "vitest --run",
		"typecheck": "tsc"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": ">=0.99.0",
		"@earendil-works/pi-coding-agent": ">=0.99.0",
		"typebox": ">=1.0.0"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "1.5.0",
		"@earendil-works/pi-coding-agent": "1.5.0",
		"@types/node": "22.19.19",
		"typescript": "5.9.3",
		"vitest": "3.2.7"
	}
}
