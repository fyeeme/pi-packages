{
	"name": "@fyeeme/pi-todo",
	"version": "1.0.5",
	"description": "File-based todos for pi — a todo tool (list, list-all, get, create, update, append, delete, claim, release) over markdown files in .pi/todos with per-todo locks and garbage collection, plus a /todos interactive manager. Rewritten from mitsuhiko/agent-stuff todos.ts.",
	"type": "module",
	"license": "MIT",
	"author": "fyeeme",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fyeeme/pi-packages.git"
	},
	"bugs": {
		"url": "https://github.com/fyeeme/pi-packages/issues"
	},
	"homepage": "https://github.com/fyeeme/pi-packages#readme",
	"engines": {
		"node": ">=18"
	},
	"keywords": [
		"pi-package",
		"pi",
		"extension",
		"todo",
		"todos",
		"tasks",
		"checklist",
		"files"
	],
	"files": [
		"index.ts",
		"test",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"scripts": {
		"test": "vitest --run",
		"typecheck": "tsc"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": ">=0.99.0",
		"@earendil-works/pi-coding-agent": ">=0.99.0",
		"@earendil-works/pi-tui": ">=0.99.0",
		"typebox": ">=1.0.0"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "1.5.0",
		"@earendil-works/pi-coding-agent": "1.5.0",
		"@earendil-works/pi-tui": "1.5.0",
		"@types/node": "22.19.19",
		"typebox": "1.3.27",
		"typescript": "5.9.3",
		"vitest": "3.2.7"
	}
}
