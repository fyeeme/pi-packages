  },
  "bugs": {
    "url": "https://github.com/fyeeme/pi-packages/issues"
  },
  "homepage": "https://github.com/fyeeme/pi-packages#readme",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "pi-package",
    "pi",
    "status-line",
    "statusline",
    "deepseek",
    "tokens",
    "cost",
    "mcp",
    "balance",
    "footer"
  ],
  "files": [
