{
  "name": "@fyeeme/pi-dynamic-workflows",
  "version": "0.1.0",
  "description": "Deterministic TypeScript workflow orchestration for pi. Fuses the pi-dynamic-workflows design (declarative graph, 7 step primitives, heuristic planner, outcome collectors) with Claude Code's workflow engine coordination mechanisms (deterministic sandbox, cache-key resume, per-agent abort map, dynamic budget, runaway caps).",
  "type": "module",
  "license": "MIT",
  "author": "fyeeme",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "pi-package",
    "pi",
    "dynamic-workflow",
    "workflow",
    "orchestration",
    "fan-out",
    "pipeline",
    "multi-agent"
  ],
  "files": [
    "*.ts",
    "src/**/*.ts",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "vitest --run",
    "typecheck": "tsc"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.77.0",
    "@earendil-works/pi-coding-agent": ">=0.77.0",
    "@earendil-works/pi-tui": ">=0.77.0",
    "jiti": ">=2.0.0",
    "typebox": ">=1.0.0",
    "typescript": ">=5.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.77.0",
    "@earendil-works/pi-coding-agent": "0.77.0",
    "@earendil-works/pi-tui": "0.77.0",
    "@types/node": "22.19.19",
    "jiti": "2.7.0",
    "typebox": "1.1.38",
    "typescript": "5.9.3"
  }
}
